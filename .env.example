# Copy to `.env` in the repo root (not committed). Loaded by `scripts/dev-commmaker.ps1`.
ANTHROPIC_API_KEY=
# Optional: Anthropic Console workspace id for multi-workspace user keys (header anthropic-workspace-id)
# ANTHROPIC_WORKSPACE_ID=
# Optional: override frontier model (default anthropic: claude-sonnet-5-5; Opus: claude-opus-4-8)
# COMMMAKER_LLM_MODEL=claude-opus-4-8
IDEOGRAM_API_KEY=
# Optional: vision model for the Onboard brand profile (defaults to the creative-brief model)
# COMMMAKER_BRAND_PROFILE_MODEL=claude-sonnet-5-5
# Optional: explicit Chrome/Chromium for Playwright screenshots
# COMMMAKER_CHROME_PATH=
